# Server-only credentials. Put real values in .env.local; never use NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Existing AGNIC_TOKEN is also accepted; do not duplicate an existing token.
AGNIC_API_KEY=

# Paid model calls require explicit opt-in. Local .env.local is enabled per user consent.
SENTINEL_ALLOW_PAID_AI=false
# Hard-coded server lock stays disabled even if these values are changed.
SENTINEL_REAL_PURCHASES_ENABLED=false
SENTINEL_DEVELOPMENT_MODE=true
# Reserved future limit only. Current permitted purchase spend is zero.
SENTINEL_MAX_REAL_ORDER_CAD=1

# OpenAI remains the working provider. Gateway is an unenabled extension point.
AI_PROVIDER=openai
# No model is assumed or silently substituted on the Agnic AI Gateway.
AGNIC_AI_MODEL=

# Inspect Mode: optional model override for the one multimodal analysis call.
# Must be a known model key (gpt-5.6-luna or gpt-6-astra); defaults to Luna otherwise.
SENTINEL_INSPECT_MODEL=
# DEV ONLY. Set to a fixture name (e.g. broken-office-chair-caster) to bypass the
# paid vision call during local development. Leave unset for any real demo or use;
# the UI always marks a fixture result as "DEVELOPMENT FIXTURE" when this is set.
# Rejected outside development/test even if set (never a silent live fallback).
SENTINEL_INSPECT_FIXTURE=

# Build Mode: optional model override for the one scene-analysis call per submitted image.
# Must be a known model key (gpt-5.6-luna or gpt-6-astra); defaults to Luna otherwise.
SENTINEL_BUILD_MODEL=
# Build Mode session signing: only needed for a real multi-instance deployment (separate
# worker processes/machines that don't share a filesystem). Leave unset for local dev; a
# secret is then generated once and persisted to .sentinel/build-session-secret so it
# survives dev-server restarts. If set, use the same value on every instance.
SENTINEL_BUILD_SESSION_SECRET=
# DEV ONLY. Set to a fixture name (gaming-desk-setup, home-office-setup,
# simple-streaming-setup) to bypass the paid scene call during local development.
# Leave unset for any real demo or use. Rejected outside development/test.
SENTINEL_BUILD_FIXTURE=

# Populate ONLY after manually vaulting a documented TEST card at Agnic's hosted page.
# Never enter raw card data here. No account default card is used.
SENTINEL_SANDBOX_CARD_ALIAS_ID=
SENTINEL_SANDBOX_CARD_CONFIRMED=false
# Optional organizer-provided merchant ID; its live is_test flag is always verified.
SENTINEL_SANDBOX_MERCHANT_ID=merchant_untitled_fidget_shop
